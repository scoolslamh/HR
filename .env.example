# انسخ هذا الملف إلى .env ثم أدخل قيمة سرية قوية محليًا.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# مفاتيح منفصلة مطلوبة لميزة استيراد بيانات الموظفين. لا تضع قيم الإنتاج هنا.
PII_ENCRYPTION_KEY=
NATIONAL_ID_HMAC_KEY=
PII_ENCRYPTION_KEY_VERSION=v1

# الحد الأقصى لملف بيانات الموظفين بالبايت (5 MiB افتراضيًا).
EMPLOYEE_IMPORT_MAX_BYTES=5242880
